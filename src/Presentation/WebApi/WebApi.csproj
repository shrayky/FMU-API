<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>fmu-api-check</AssemblyName>
    <SignAssembly>False</SignAssembly>
	<Version>12.1.3</Version>

      <!--<PublishTrimmed>true</PublishTrimmed>
      <TrimMode>partial</TrimMode>
      <EnableTrimAnalyzer>true</EnableTrimAnalyzer>-->

      <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

      <DebugType>none</DebugType>
      <DebugSymbols>false</DebugSymbols>

      <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Net.Http.Headers" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\FmuApiApplication\FmuApiApplication.csproj" />
    <ProjectReference Include="..\..\Core\Shared\Shared.csproj" />
    <ProjectReference Include="..\..\Infrastructure\ApllicationConfigurationService\ApplicationConfigurationService.csproj" />
    <ProjectReference Include="..\..\Infrastructure\AutoUpdateWorkerService\AutoUpdateWorkerService.csproj" />
    <ProjectReference Include="..\..\Infrastructure\CentralServerExchange\CentralServerExchange.csproj" />
    <ProjectReference Include="..\..\Infrastructure\CouchDb\CouchDb.csproj" />
    <ProjectReference Include="..\..\Infrastructure\DaemonsManager\ServicesAndDaemonsManager.csproj" />
    <ProjectReference Include="..\..\Infrastructure\FrontolDb\FrontolDb.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LocalModuleIntegration\LocalModuleIntegration.csproj" />
    <ProjectReference Include="..\..\Infrastructure\LogService\LogService.csproj" />
    <ProjectReference Include="..\..\Infrastructure\PacketTrapper\PacketTrapper\FmuPacketTrapper.csproj" />
    <ProjectReference Include="..\..\Infrastructure\TrueApiCdn\TrueApi.csproj" />
    <ProjectReference Include="..\..\Infrastructure\TrueApiIntegration\TrueApiIntegration.csproj" />
    <ProjectReference Include="..\..\Infrastructure\TsPiotClinet\TsPiotClinet.csproj" />
  </ItemGroup>

  <!-- npm ci подтягивает devDependencies (vite) из package-lock; без node_modules npm run build падает с "vite не является командой". SkipNpmBuild=true, когда vite уже собран отдельно (NUKE BuildFrontend). -->
  <Target Name="NpmBuild" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(SkipNpmBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(ProjectDir)wwwroot" />
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)wwwroot" />
  </Target>

    <!-- После копирования wwwroot в публикацию убираем исходники фронта и node_modules — в рантайне нужны bundle, lib, favicon. -->
    <Target Name="PrunePublishedWwwroot" AfterTargets="Publish" Condition="Exists('$(PublishDir)wwwroot')">
        <Exec Command="node &quot;$(ProjectDir)wwwroot\scripts\prune-wwwroot.mjs&quot; &quot;$(PublishDir)wwwroot&quot;" />
    </Target>

    <Target Name="CleanupPublishFolder" AfterTargets="PrunePublishedWwwroot">
        <ItemGroup>
            <FilesToDelete Include="$(PublishDir)**\*.pdb" />
            <FilesToDelete Include="$(PublishDir)**\*.json" />
        </ItemGroup>
        <Delete Files="@(FilesToDelete)" />
        <Message Text="Удалены .pdb и .json файлы из папки публикации" Importance="high" />
    </Target>

</Project>
