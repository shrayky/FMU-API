@page
@using WebApi.Pages
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@inject IWebHostEnvironment Environment
@model IndexModel
@{
    ViewData["Title"] = $"fmu-api-{Model.NodeName}";
}

<div id="parameters" hidden>
    <input asp-for="ApiServerIpPort"/>
</div>

<textarea id="fmuScanCapture"
          autofocus
          inputmode="none"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          tabindex="0"
          aria-hidden="true"
          style="position:fixed;inset:0;opacity:0;z-index:0;border:0;padding:0;margin:0;resize:none;overflow:hidden;font-size:16px;pointer-events:none;"></textarea>

<div id="app" style="width:100vw; height:100vh;"></div>
<div id="window" style='width:80%; height:80%;' hidden></div>

@section Scripts {
    @if (Environment.IsDevelopment())
    {
        <script src="~/js/views/index.js" type="module"></script>
    }
    else
    {
        <script src="~/bundle/index.js" asp-append-version="true"></script>
    }
}
